# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These credentials are issued by a Corrigo System Administrator against a user
# account holding the WSDK role (or any role with Permissions > Web Services
# Access). The client secret is displayed once and the dialog cannot be
# reopened. See docs/credential-request.md.

CORRIGO_CLIENT_ID=
CORRIGO_CLIENT_SECRET=
CORRIGO_COMPANY_NAME=

# Optional overrides. Leave unset unless Corrigo tells you otherwise — the
# service host is discovered at runtime via GetCompanyWsdkUrlCommand and must
# never be hardcoded.
# CORRIGO_OAUTH_URL=https://oauth-pro-v2.corrigo.com/OAuth/token
# CORRIGO_LOCATOR_HOST=https://am-apilocator.corrigo.com

# Where the local store lives. Read by the API service and the MCP server.
# BNSF_FM_DB=data/bnsf_fm.db

# Only needed for AI-written resolution prose. Without it, note drafting falls
# back to deterministic rule-based extraction and still works.
# ANTHROPIC_API_KEY=
